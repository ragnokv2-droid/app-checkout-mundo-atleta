{
  "expo": {
    "name": "Mundo Atleta",
    "slug": "mundo-atleta-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mundoatleta",
    "userInterfaceStyle": "light",
    "android": {
      "package": "shop.mundoatleta.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0d9488"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#0d9488"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "https://mundo-atleta-checkout.vercel.app",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9713f2de-44eb-45b9-905c-3356297719b0"
      }
    },
    "owner": "appcheckoutmundoatleta"
  }
}