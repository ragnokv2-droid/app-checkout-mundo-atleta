{
  "expo": {
    "name": "Mundo Atleta",
    "slug": "mundo-atleta-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mundoatleta",
    "userInterfaceStyle": "light",
    "android": {
      "package": "shop.mundoatleta.app",
      "adaptiveIcon": {
        "backgroundColor": "#0d9488"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#0d9488"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://mundo-atleta-checkout.vercel.app"
    }
  }
}
